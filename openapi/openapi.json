{
  "openapi": "3.1.0",
  "info": {
    "title": "PBE API",
    "version": "0.1.0",
    "description": "PBE — Predictive Bioequivalence Engine. Decision-support software; outputs do not establish bioequivalence."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "summary": "Liveness check",
        "description": "Confirms that the API process is running. Returns no tenant data.",
        "tags": [
          "health"
        ],
        "security": [],
        "x-pbe-permission": "PUBLIC",
        "x-pbe-idempotency": "NOT_APPLICABLE",
        "responses": {
          "200": {
            "description": "The API process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthLiveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "pbe-api"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "additionalProperties": false,
        "description": "Liveness status of the PBE API process."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false,
        "description": "RFC 9457 problem details. Never contains scientific values, file contents or secrets."
      }
    }
  }
}
