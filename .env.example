# PBE local configuration. Copy nothing by hand: `npm run db:bootstrap` writes the real .env
# (git-ignored, permissions 600). Values in angle brackets are placeholders.
PBE_PG_HOST=localhost
PBE_PG_PORT=5432
PBE_PG_BIN=/Library/PostgreSQL/18/bin
# ADR-020: development and automated-test databases are separate.
PBE_PG_DEV_DATABASE=pbe_dev
PBE_PG_TEST_DATABASE=pbe_test
PBE_PG_MIGRATOR_USER=pbe_migrator
PBE_PG_MIGRATOR_PASSWORD=<generated-by-db-bootstrap>
PBE_PG_APP_USER=pbe_app
PBE_PG_APP_PASSWORD=<generated-by-db-bootstrap>
# Test-only role used by the restore drill (ADR-020).
PBE_PG_RESTORE_USER=pbe_restore_drill
PBE_PG_RESTORE_PASSWORD=<generated-by-db-bootstrap>
# Backup login (BYPASSRLS, read-only; STAGE-07A-BACKUP-REVIEW.md).
PBE_PG_BACKUP_USER=pbe_backup
PBE_PG_BACKUP_PASSWORD=<generated-by-db-bootstrap>
