{
  "name": "@pbe/web",
  "version": "0.0.0",
  "private": true,
  "description": "PBE web user interface (Next.js; ADR-001, ADR-024, ADR-025)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3000",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "NEXT_TELEMETRY_DISABLED=1 playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jest-environment-jsdom": "30.5.2",
    "otpauth": "9.5.2"
  }
}
