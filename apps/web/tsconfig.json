{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "resolveJsonModule": true,
    "incremental": false,
    "declaration": false,
    "types": ["jest", "node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["app", "src", "test", "e2e", "proxy.ts", "next.config.ts"]
}
