# PBE API — example environment. Copy to apps/api/.env for local use. Never commit .env.
# Contains no secrets in Stage 1. Database settings arrive in Stage 2.

# development | test | production
NODE_ENV=development
# Interface and port the API listens on. 127.0.0.1 keeps the API local-only.
HOST=127.0.0.1
PORT=4000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
